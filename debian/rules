#!/usr/bin/make -f
#
# Manannan - plugin-based dynamic DNS updater
#
# Copyright (C) 2026 Tom Cully <mail@tomcully.com>
# Licensed under the GNU GPLv3 - see <https://www.gnu.org/licenses/gpl-3.0.html>
#
# The CMake install rules say where everything goes; the .install files split
# it between manannan and manannan-dev.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
TESTS = OFF
else
TESTS = ON
endif

%:
	dh $@ --buildsystem=cmake --builddirectory=debian/build

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DMANANNAN_BUILD_TESTING=$(TESTS)

# The test binary rather than ctest. Every request the tests make goes to a
# server of their own on the loopback interface.
override_dh_auto_test:
ifeq ($(TESTS),ON)
	debian/build/tests/manannan_tests
endif

# The packaged configuration is an example, so the service is installed
# disabled and not started. An upgrade restarts it if it is enabled or running.
override_dh_installsystemd:
	dh_installsystemd --no-enable
