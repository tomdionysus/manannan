[Unit]
Description=Manannan registry updater
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_SBINDIR@/manannan @CMAKE_INSTALL_FULL_SYSCONFDIR@/manannan/manannan.yaml
Restart=on-failure
RestartSec=10s
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
EnvironmentFile=-@CMAKE_INSTALL_FULL_SYSCONFDIR@/manannan/environment

[Install]
WantedBy=multi-user.target
